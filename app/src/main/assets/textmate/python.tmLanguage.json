{
    "name": "Python",
    "scopeName": "source.python",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#decorators" },
        { "include": "#keywords" },
        { "include": "#function-def" },
        { "include": "#class-def" },
        { "include": "#imports" },
        { "include": "#builtins" },
        { "include": "#function-call" },
        { "include": "#numbers" },
        { "include": "#type-annotation" },
        { "include": "#operators" },
        { "include": "#brackets" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.python",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.python",
                    "begin": "(?i)(r|b|f|rb|br|rf|fr)?\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [ { "include": "#escapes" }, { "include": "#fstring-expr" } ]
                },
                {
                    "name": "string.quoted.triple.python",
                    "begin": "(?i)(r|b|f|rb|br|rf|fr)?'''",
                    "end": "'''",
                    "patterns": [ { "include": "#escapes" }, { "include": "#fstring-expr" } ]
                },
                {
                    "name": "string.quoted.double.python",
                    "begin": "(?i)(r|b|f|rb|br|rf|fr)?\"",
                    "end": "\"",
                    "patterns": [ { "include": "#escapes" }, { "include": "#fstring-expr" } ]
                },
                {
                    "name": "string.quoted.single.python",
                    "begin": "(?i)(r|b|f|rb|br|rf|fr)?'",
                    "end": "'",
                    "patterns": [ { "include": "#escapes" }, { "include": "#fstring-expr" } ]
                }
            ]
        },
        "escapes": {
            "name": "constant.character.escape.python",
            "match": "\\\\(x[0-9A-Fa-f]{2}|[0-7]{1,3}|['\"abfnrtv\\\\]|N\\{[^}]+\\}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        "fstring-expr": {
            "name": "meta.embedded.expression.python",
            "match": "\\{[^{}]*\\}"
        },
        "decorators": {
            "name": "entity.name.decorator.python",
            "match": "^\\s*@[A-Za-z_][A-Za-z0-9_.]*"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.python",
                    "match": "\\b(if|elif|else|for|while|break|continue|pass|return|yield|raise|try|except|finally|with|as|match|case|async|await)\\b"
                },
                {
                    "name": "keyword.operator.logical.python",
                    "match": "\\b(and|or|not|in|is)\\b"
                },
                {
                    "name": "keyword.other.python",
                    "match": "\\b(lambda|global|nonlocal|del|assert)\\b"
                },
                {
                    "name": "constant.language.python",
                    "match": "\\b(True|False|None|NotImplemented|Ellipsis)\\b"
                }
            ]
        },
        "function-def": {
            "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "storage.type.function.python" },
                "2": { "name": "entity.name.function.python" }
            }
        },
        "class-def": {
            "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "storage.type.class.python" },
                "2": { "name": "entity.name.class.python" }
            }
        },
        "imports": {
            "name": "keyword.control.import.python",
            "match": "\\b(import|from)\\b"
        },
        "builtins": {
            "name": "support.function.builtin.python",
            "match": "\\b(print|len|range|open|input|str|int|float|bool|list|dict|set|tuple|type|isinstance|super|enumerate|zip|map|filter|sorted|reversed|sum|min|max|abs|round|any|all|iter|next|repr|format|getattr|setattr|hasattr|delattr|property|staticmethod|classmethod)\\b"
        },
        "function-call": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "name": "meta.function-call.python",
            "captures": {
                "1": { "name": "entity.name.function.python" }
            }
        },
        "numbers": {
            "name": "constant.numeric.python",
            "match": "\\b(0[xX][0-9A-Fa-f]+|0[oO][0-7]+|0[bB][01]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?[jJ]?)\\b"
        },
        "type-annotation": {
            "name": "support.type.python",
            "match": "(?<=:\\s)[A-Za-z_][A-Za-z0-9_.\\[\\], ]*(?=\\s*[=,)]|\\s*$)|(?<=->\\s)[A-Za-z_][A-Za-z0-9_.\\[\\], ]*(?=:)"
        },
        "operators": {
            "name": "keyword.operator.python",
            "match": "(\\*\\*=|//=|<<=|>>=|->|==|!=|<=|>=|\\*\\*|//|<<|>>|[+\\-*/%&|^~<>=!:]=?)"
        },
        "brackets": {
            "name": "punctuation.section.brackets.python",
            "match": "[\\[\\]{}()]"
        }
    }
}