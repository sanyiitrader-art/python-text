<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/item_language.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/popup_bg"
    android:padding="12dp">

    <!-- Ring around the language badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ring"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:max="100"
            app:indicatorSize="52dp"
            app:trackThickness="3dp"
            app:indicatorColor="@color/accent_grey"
            app:trackColor="@color/border_divider" />

        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text_normal" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_normal" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_comment" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:minWidth="88dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textColor="@color/text_normal"
        android:textStyle="bold"
        android:textSize="13sp"
        android:background="@drawable/tab_selected_bg"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>