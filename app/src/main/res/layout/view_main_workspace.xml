<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_background">

    <LinearLayout
        android:id="@+id/group_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="48dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nothing_to_open"
            android:textColor="@color/text_comment"
            android:textStyle="italic"
            android:alpha="0.7"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item 7: button words are grey now -->
            <TextView
                android:id="@+id/btn_open_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_folder"
                android:textColor="@color/accent_grey"
                android:textSize="15sp"
                android:gravity="center"
                android:background="@drawable/popup_bg"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_open_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_file"
                android:textColor="@color/accent_grey"
                android:textSize="15sp"
                android:gravity="center"
                android:background="@drawable/popup_bg"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_folder_browse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_no_python_files_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_python_files"
            android:textColor="@color/text_comment"
            android:textStyle="italic"
            android:alpha="0.7"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="48dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_folder_browse_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp" />

    </LinearLayout>

</FrameLayout>