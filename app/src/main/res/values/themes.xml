<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PyEdit" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/mint_primary</item>
        <item name="colorPrimaryDark">@color/topbar_background</item>
        <item name="colorAccent">@color/mint_primary</item>
        <item name="android:windowBackground">@color/editor_background</item>
        <item name="android:statusBarColor">@color/topbar_background</item>
        <item name="android:navigationBarColor">@color/editor_background</item>
        <item name="android:textColor">@color/text_normal</item>
        <item name="android:textColorPrimary">@color/text_normal</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Renamed without dots: "PopupMenu.SectionLabel" etc. would make
         AAPT look for an implicit non-existent parent style "PopupMenu". -->
    <style name="PopupMenuSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/mint_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PopupMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text_normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PopupMenuItemRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="PopupMenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@color/border_divider</item>
    </style>

    <style name="ToolbarKey">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/text_normal</item>
    </style>

    <style name="ToolbarTextKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/mint_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="ToolbarDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@color/border_divider</item>
    </style>
</resources>